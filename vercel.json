{
  "functions": {
    "api/anthropic.js": {
      "maxDuration": 60
    },
    "api/migrate.js": {
      "maxDuration": 60,
      "includeFiles": "supabase/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
